# Sentinel Nova environment variables
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
AUTH_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional, explicit failover model IDs supported by your Gemini API account.
GEMINI_FALLBACK_MODELS=
GEMINI_ROUTER_TIMEOUT_MS=7000
GEMINI_MAX_MODEL_ATTEMPTS=2
# Optional local runtime configuration (do not share this JSON directory across server processes).
# SENTINEL_NOVA_DATA_DIR=./data
# SENTINEL_NOVA_PYTHON=python
# SENTINEL_NOVA_ML_ARTIFACT_DIR=./ml/models
